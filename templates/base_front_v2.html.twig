46 2.98475Z" fill="#00905D"/></svg>

            <p class="flex-1">
                <strong class="font-semibold">Vous êtes bien chez Cojob Nantes !</strong>
                Notre site est en cours de refonte : la page d’accueil change, les autres pages seront mises à jour progressivement.
            </p>

            <button type="button"
                    class="shrink-0 rounded p-1 transition hover:bg-black/5"
                    aria-label="Fermer le bandeau"
                    data-action="banner#dismiss">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>
        </div>
    </div>
    <header class="sticky top-0 z-50 border-brand-whitedark border-b bg-white font-semibold backdrop-blur">
        <nav class="relative mx-auto flex h-20 items-center justify-between px-4 group xl:px-20"
            data-controller="menu"
            data-action="click@window->menu#closeOnClickOutside keydown.esc@window->menu#closeDropdowns">
            <a href="{{ path('homepage') }}" class="flex shrink-0 items-center gap-2">
                <picture>
                    <source
                        type="image/avif"
                        srcset="{{ asset('img/v2/logo/header/logo-109.avif') }} 1x,
                        {{ asset('img/v2/logo/header/logo-109@2x.avif') }} 2x"
                    >
                    <source
                        type="image/webp"
                        srcset="{{ asset('img/v2/logo/header/logo-109.webp') }} 1x,
                        {{ asset('img/v2/logo/header/logo-109@2x.webp') }} 2x"
                    >
                    <img
                        src="{{ asset('img/v2/logo/header/logo-109.png') }}"
                        srcset="{{ asset('img/v2/logo/header/logo-109.png') }} 1x,
                        {{ asset('img/v2/logo/header/logo-109@2x.png') }} 2x"
                        alt="Cojob Nantes"
                        width="109"
                        height="38"
                        fetchpriority="high">
                </picture>
                <span class="sr-only">Cojob Nantes</span>
            </a>

            <div class="hidden items-center gap-4 text-[15px] text-navy-900 lg:flex">
                <twig:Menu:Item location="header" href="{{ path('homepage') }}#about">{{ 'v2.nav.about'|trans }}</twig:Menu:Item>
                <twig:Menu:Item location="header" href="{{ path('promos') }}">{{ 'nav.promo'|trans }}</twig:Menu:Item>
                <twig:Menu:Item location="header" href="{{ path('calendar') }}#about">{{ 'nav.calendar'|trans }}</twig:Menu:Item>
                <details class="relative inline-block" data-menu-target="dropdown">
                    <summary class="flex items-center gap-1 list-none transition cursor-pointer hover:underline">
                        {{ 'nav.support_us'|trans }}
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </summary>

                    <div class="absolute right-0 z-10 mt-2 w-48 rounded-[4px] ring-1 ring-black/5 bg-white px-4 py-1 shadow-lg">
                        <twig:Menu:DropdownItem href="{{ path('support') }}#join-form" gTagEventName="Join Link Header">
                            {{ 'v2.nav.join'|trans }}
                        </twig:Menu:DropdownItem>
                        <twig:Menu:DropdownItem href="{{ path('support') }}#donate-form" gTagEventName="Donate Link Header">
                            {{ 'v2.nav.donate'|trans }}
                        </twig:Menu:DropdownItem>
                        <twig:Menu:DropdownItem href="{{ path('support') }}" gTagEventName="Become volunteer Link Header">
                            {{ 'v2.nav.become_volunteer'|trans }}
                        </twig:Menu:DropdownItem>
                    </div>
                </details>
            </div>

            <div class="flex items-center gap-4">
                <div class="hidden items-center gap-3 text-navy-900 md:flex">
                    <twig:Social:Buttons location='Head' />
                </div>
                <twig:Button href="{{ path('promos') }}#promoAnchor" class="inline-flex"
                    role="button" class="inline-flex max-lg:group-has-[[aria-expanded=true]]:hidden">
                    <span class="hidden sm:inline">{{ 'v2.home.promo_registration_sm'|trans }}</span>
                    <span class="sm:hidden">{{ 'v2.home.promo_registration'|trans }}</span>
                </twig:Button>
                <button class="flex h-9 w-9 items-center justify-center lg:hidden"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    aria-label="{{ 'toggle_navigation'|trans }}"
                    data-menu-target="button"
                    data-action="menu#toggle">
                    <svg data-menu-target="openIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg data-menu-target="closeIcon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <ul id="mobile-menu" data-menu-target="panel"
                    class="absolute inset-x-0 top-full z-50 hidden w-full bg-white pb-4 shadow-lg lg:hidden">
                    <li><twig:Menu:Item location="header" href="{{ path('homepage') }}#about" class="block px-4 py-3">
                        {{ 'v2.nav.about'|trans }}
                    </twig:Menu:Item></li>
                    <li><twig:Menu:Item location="header" href="{{ path('promos') }}" class="block px-4 py-3">
                        {{ 'nav.promo'|trans }}
                    </twig:Menu:Item></li>
                    <li><twig:Menu:Item location="header" href="{{ path('calendar') }}" class="block px-4 py-3">
                        {{ 'nav.calendar'|trans }}
                    </twig:Menu:Item></li>
                    <li>
                        <details class="block px-4 py-3 group">
                            <summary class="flex items-center gap-1 list-none transition cursor-pointer hover:underline">
                                {{ 'nav.support_us'|trans }}
                                <svg class="h-3.5 w-3.5 transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                            </summary>

                            <ul class="mt-1 font-normal text-[15px]">
                                <li>
                                    <twig:Menu:DropdownItem href="{{ path('support') }}#join-form" gTagEventName="Join Link Header">
                                        {{ 'v2.nav.join'|trans }}
                                    </twig:Menu:DropdownItem>
                                </li>
                                <li>
                                    <twig:Menu:DropdownItem href="{{ path('support') }}#donate-form" gTagEventName="Donate Link Header">
                                        {{ 'v2.nav.donate'|trans }}
                                    </twig:Menu:DropdownItem>
                                </li>
                                <li>
                                    <twig:Menu:DropdownItem href="{{ path('support') }}" gTagEventName="Become volunteer Link Header">
                                        {{ 'v2.nav.become_volunteer'|trans }}
                                    </twig:Menu:DropdownItem>
                                </li>
                            <ul>
                        </details>
                    </li>
                    <li class="md:hidden">
                        <div class="flex items-center gap-4 px-4 py-3 text-navy-900">
                            <twig:Social:Buttons location='Head' />
                        </div>
                    </li>
                    <li class="px-4 py-3">
                        <twig:Button href="{{ path('promos') }}#promoAnchor"
                            role="button" class="block text-center">
                            {{ 'v2.home.promo_registration_sm'|trans }}
                        </twig:Button>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
{% endblock %}
