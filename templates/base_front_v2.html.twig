{% extends 'base_v2.html.twig' %}

{% block meta %}
    <!-- Open Graph meta -->
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:type" content="siteweb">
    {% if block('canonical') is defined %}
        <meta property="og:url" content="{{ block('canonical') }}">
    {% endif %}
    {% block og_image %}
        <meta property="og:image" content="{{ absolute_url(asset('images/promo.jpg')) }}">
    {% endblock %}
    <meta property="og:description" content="{{ block('description') }}">

    {% if block('canonical') is defined %}
        <link rel="alternate" href="{{ block('canonical') }}" hreflang="fr-fr">
    {% endif %}
{% endblock %}

{% block header %}
    <header class="sticky top-0 z-50 bg-white backdrop-blur border-b border-brand-whitedark font-semibold">
        <nav class="px-4 xl:px-20 mx-auto h-20 flex items-center justify-between relative"
            data-controller="menu"
            data-action="click@window->menu#closeOnClickOutside">
            <a href="{{ path('homepage') }}" class="flex items-center gap-2 shrink-0">
                <picture>
                    <source
                        type="image/avif"
                        srcset="{{ asset('img/v2/logo/header/logo-109.avif') }} 1x,
                        {{ asset('img/v2/logo/header/logo-109@2x.avif') }} 2x"
                    >
                    <source
                        type="image/webp"
                        srcset="{{ asset('img/v2/logo/header/logo-109.webp') }} 1x,
                        {{ asset('img/v2/logo/header/logo-109@2x.webp') }} 2x"
                    >
                    <img
                        src="{{ asset('img/v2/logo/header/logo-109.png') }}"
                        srcset="{{ asset('img/v2/logo/header/logo-109.png') }} 1x,
                        {{ asset('img/v2/logo/header/logo-109@2x.png') }} 2x"
                        alt="Cojob Nantes"
                        width="109"
                        height="38"
                        fetchpriority="high">
                </picture>
                <span class="sr-only">Cojob Nantes</span>
            </a>

            <div class="hidden lg:flex items-center gap-4 text-[15px] text-navy-900">
                <twig:Menu:Item location="header" href="{{ path('homepage') }}#about">{{ 'v2.nav.about'|trans }}</twig:Menu:Item>
                <twig:Menu:Item location="header" href="{{ path('promos') }}">{{ 'nav.promo'|trans }}</twig:Menu:Item>
                <twig:Menu:Item location="header" href="{{ path('calendar') }}#about">{{ 'nav.calendar'|trans }}</twig:Menu:Item>
                <details class="relative inline-block">
                    <summary class="cursor-pointer flex items-center gap-1 hover:text-brand-blue transition list-none">
                        {{ 'nav.support_us'|trans }}
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                    </summary>

                    <div class="absolute right-0 mt-2 w-48 rounded-md bg-white py-1 shadow-lg ring-1 ring-black/5 z-10">
                        <twig:Menu:DropdownItem href="{{ path('support') }}#join-form" gTagEventName="Join Link Header">
                            {{ 'v2.nav.join'|trans }}
                        </twig:Menu:DropdownItem>
                        <twig:Menu:DropdownItem href="{{ path('support') }}#donate-form" gTagEventName="Donate Link Header">
                            {{ 'v2.nav.donate'|trans }}
                        </twig:Menu:DropdownItem>
                        <twig:Menu:DropdownItem href="{{ path('support') }}" gTagEventName="Become volunteer Link Header">
                            {{ 'v2.nav.join'|trans }}
                        </twig:Menu:DropdownItem>
                    </div>
                </details>
            </div>

            <div class="flex items-center gap-4">
                <div class="hidden md:flex items-center gap-3 text-navy-900">
                    <twig:Social:Buttons location='Head' />
                </div>
                <twig:Button href="{{ path('promos') }}#promoAnchor" class="hidden sm:inline-flex"
                    role="button">
                    {{ 'v2.home.promo_registration'|trans }}
                </twig:Button>
                <button class="lg:hidden w-9 h-9 flex items-center justify-center"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                    aria-label="{{ 'toggle_navigation'|trans }}"
                    data-menu-target="button"
                    data-action="menu#toggle">
                    {# <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg> #}
                    <svg data-menu-target="openIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg data-menu-target="closeIcon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <ul id="mobile-menu" data-menu-target="panel"
                    class="hidden absolute inset-x-0 top-full z-50 w-full bg-white shadow-lg lg:hidden pb-4">
                    <li><twig:Menu:Item location="header" href="{{ path('homepage') }}#about" class="block px-4 py-3">
                        {{ 'v2.nav.about'|trans }}
                    </twig:Menu:Item></li>
                    <li><twig:Menu:Item location="header" href="{{ path('promos') }}" class="block px-4 py-3">
                        {{ 'nav.promo'|trans }}
                    </twig:Menu:Item></li>
                    <li><twig:Menu:Item location="header" href="{{ path('calendar') }}" class="block px-4 py-3">
                        {{ 'nav.calendar'|trans }}
                    </twig:Menu:Item></li>
                    <li>
                        <details class="relative block px-4 py-3">
                            <summary class="cursor-pointer flex items-center gap-1 hover:text-brand-blue transition list-none">
                                {{ 'nav.support_us'|trans }}
                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                            </summary>

                            <div class="absolute mt-2 w-5/6 rounded-md bg-white py-1 shadow-lg ring-1 ring-black/5 z-10">
                                <twig:Menu:DropdownItem href="{{ path('support') }}#join-form" gTagEventName="Join Link Header">
                                    {{ 'v2.nav.join'|trans }}
                                </twig:Menu:DropdownItem>
                                <twig:Menu:DropdownItem href="{{ path('support') }}#donate-form" gTagEventName="Donate Link Header">
                                    {{ 'v2.nav.donate'|trans }}
                                </twig:Menu:DropdownItem>
                                <twig:Menu:DropdownItem href="{{ path('support') }}" gTagEventName="Become volunteer Link Header">
                                    {{ 'v2.nav.join'|trans }}
                                </twig:Menu:DropdownItem>
                            </div>
                        </details>
                    </li>
                    <li class="md:hidden">
                        <div class="flex items-center gap-3 text-navy-900 px-4 py-3">
                            <twig:Social:Buttons location='Head' />
                        </div>
                    </li>
                    <li class="px-4 py-3 sm:hidden">
                        <twig:Button href="{{ path('promos') }}#promoAnchor"
                            role="button">
                        {{ 'v2.home.promo_registration'|trans }}
                        </twig:Button>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
{% endblock %}
