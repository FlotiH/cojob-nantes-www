<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{% endblock %}</title>
        <meta name="description" content="{% block description %}{% endblock %}">
        {% if block('canonical') is defined %}
            <link rel="canonical" href="{{ block('canonical') }}">
        {% endif %}

        {% block meta %}{% endblock %}

        {% if app.environment == 'prod' %}
            <!-- Global site tag (gtag.js) - Google Analytics -->
            <script async src="https://www.googletagmanager.com/gtag/js?id=UA-128778519-1"></script>
            <script>
            window.dataLayer = window.dataLayer || [];

            function gtag() {
                dataLayer.push(arguments);
            }

            gtag('js', new Date());
            gtag('config', 'UA-128778519-1');
        </script>

            <!-- Google Tag Manager -->
            <script>(function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    'gtm.start':
                        new Date().getTime(), event: 'gtm.js'
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', 'GTM-MDNN4PD');</script>
            <!-- End Google Tag Manager -->
        {% endif %}

        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}">
        <link rel="manifest" href="{{ asset('manifest.json') }}">
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}

        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                extend: {
                    colors: {
                        navy: {
                            900: '#0E3D67',
                            800: '#123258',
                            700: '#1a4272',
                        },
                        green: {
                            100: '#D6FFF1',
                            300: '#00C27D'
                        },
                        blue: {
                            100: '#F2F8FD',
                            300: '#86BDEF',
                            600: '#1A72C1'
                        },
                        orange: {
                            200: '#FFCF99'
                        },
                        yellow: {
                            500: '#F9AB10',
                        },
                        brand: {
                            blue: '#1c4f8f',
                            cream: '#fdf1dd',
                            lightblue: '#eaf1fb',
                            teal: '#189b78',
                            amber: '#f6c445',
                            orange: '#f2821f',
                            green: '#00905D',
                            whitedark: '#E9E9E9'
                        }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'ui-sans-serif', 'system-ui', 'sans-serif'],
                    }
                }
                }
            }
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <style>
        body { font-family: 'Inter', sans-serif; }
        .photo-tape::before{
            content:"";
            position:absolute;
            inset:0;
            background:repeating-linear-gradient(135deg, rgba(255,255,255,.6) 0 10px, rgba(255,255,255,0) 10px 20px);
        }
        </style>
    </head>
    <body class="bg-white text-navy-900" itemscope="" itemtype="https://schema.org/WebPage">
        <meta itemprop="name" content="COJOB Nantes">
        <meta itemprop="description" content="{{ block('description') }}">
        <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
            <meta itemprop="name" content="COJOB Nantes">
            <span itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
                <meta itemprop="url" content="{{ absolute_url(asset('images/logo.png')) }}">
            </span>
        </div>

    {% if app.environment == 'prod' %}
        <!-- Google Tag Manager (noscript) -->
        <noscript>
            <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MDNN4PD"
                    height="0" width="0" style="display:none;visibility:hidden"></iframe>
        </noscript>
        <!-- End Google Tag Manager (noscript) -->
    {% endif %}

    <div itemscope itemtype="https://schema.org/WebSite">
        <link itemprop="url" href="{{ absolute_url(path('homepage')) }}">
        <meta itemprop="inLanguage" content="FR">
        <meta itemprop="image" content="{{ absolute_url(asset('images/promo.jpg')) }}">
        <meta itemprop="headline" content="{{ block('description') }}">
        <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
            <meta itemprop="name" content="COJOB Nantes">
            <span itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ absolute_url(asset('images/logo.png')) }}">
        </span>
        </div>
        <meta itemprop="keywords"
              content="COJOB, COJOB Nantes, association, collectif, recherche, emploi, solidaire, entraide, réseau">
        <meta itemprop="sameAs"
              content="[https://www.facebook.com/cojobnantes/, https://fr.linkedin.com/company/cojob-nantes]">
    </div>

    {% block header %}{% endblock %}

    {% block content %}{% endblock %}

    <footer class="bg-navy-900 text-white pt-16 pb-8">
        <div class="max-w-[1048px] mx-auto grid sm:grid-cols-2 lg:grid-cols-[3fr_2fr_2fr_2fr] pb-12 border-b border-white/50">
            <div>
                <a href="{{ path('homepage') }}">
                {# TODO FHA : revoir les tailles quand j'aurai la bonne image #}
                    <picture>
                        <source
                            srcset="{{ asset('img/main/logo-no-bg-400.avif') }} 400w,
                            {{ asset('img/main/logo-no-bg-200.avif') }} 200w"
                            sizes="(max-width: 576px) 34vw, 100vw"
                            type="image/avif"
                        >
                        <source
                            srcset="{{ asset('img/main/logo-no-bg-400.webp') }} 400w,
                            {{ asset('img/main/logo-no-bg-200.webp') }} 200w"
                            sizes="(max-width: 576px) 34vw, 100vw"
                            type="image/webp"
                        >
                        <img
                            src="{{ asset('img/main/logo-no-bg.png') }}"
                            srcset="{{ asset('img/main/logo-no-bg-400.png') }} 400w,
                            {{ asset('img/main/logo-no-bg-200.png') }} 200w"
                            sizes="(max-width: 576px) 34vw, 100vw"
                            alt="Cojob Nantes"
                            class="w-[150px]"
                            width="400"
                            height="134"
                        >
                    </picture>
                </a>
                <p class="text-xs mt-4 leading-relaxed pr-8 max-w-xs">
                    Association favorisant une recherche d'emploi collective, proactive et solidaire.
                </p>
            </div>
            <div>
                <ul class="space-y-4 text-xs font-semibold">
                    <li><a href="{{ path('homepage') }}#about" class="hover:text-white/60">{{ 'v2.nav.about'|trans }}</a></li>
                    <li><a href="{{ path('promos') }}" class="hover:text-white/60">{{ 'nav.promo'|trans }}</a></li>
                    <li><a href="{{ path('calendar') }}" class="hover:text-white/60">{{ 'nav.calendar'|trans }}</a></li>
                    <li><a href="{{ path('partners') }}" class="hover:text-white/60">{{ 'nav.partners'|trans }}</a></li>
                </ul>
            </div>
            <div>
                <p class="text-xs font-semibold mb-4">{{ 'nav.support_us'|trans }}</p>
                <ul class="space-y-4 text-xs">
                    <li><a href="{{ path('support') }}#join-form" class="hover:text-white/60"
                        onclick="gtag('event', 'Join Link Footer', {'event_category': 'Button Click'});">
                        {{ 'v2.nav.join'|trans }}</a>
                    </li>
                    <li><a href="{{ path('support') }}#donate-form" class="hover:text-white/60"
                        onclick="gtag('event', 'Donate Link Footer', {'event_category': 'Button Click'});">
                        {{ 'v2.nav.donate'|trans }}</a>
                    </li>
                    <li><a href="{{ path('support') }}" class="hover:text-white/60"
                        onclick="gtag('event', 'Become volunteer Link Footer', {'event_category': 'Button Click'});">
                        {{ 'v2.nav.become_volunteer'|trans }}</a>
                    </li>
                </ul>
            </div>
            <div itemscope itemtype="https://schema.org/Organization">
                <meta itemprop="name" content="COJOB Nantes">
                <div itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                    <meta itemprop="streetAddress" content="boulevard salvador Allende, Les Salorges 2">
                    <meta itemprop="postalCode" content="44100">
                    <meta itemprop="addressLocality" content="Nantes, France">
                </div>
                <p class="font-semibold text-xs mb-4">{{ 'v2.footer.social_links'|trans }}</p>
                <link itemprop="url" href="{{ absolute_url(path('homepage')) }}">
                <div class="flex gap-4">
                    {{ include('button/contact.html.twig', {gtagEventName: 'Footer Email'}, with_context: false) }}
                    {{ include('button/linkedin.html.twig', {gtagEventName: 'Footer Socials LinkedIn'}, with_context: false) }}
                    {{ include('button/facebook.html.twig', {gtagEventName: 'Footer Socials Facebook'}, with_context: false) }}
                </div>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-6 lg:px-10 pt-6 flex flex-col sm:flex-row items-center justify-center gap-6 text-xs">
            <p>© COJOB Nantes 2026. Tous droits réservés.</p>
            <a href="{{ path('legals') }}" class="hover:text-white/60">{{ 'footer.legals'|trans }}</a>
        </div>
    </footer>
    </body>
</html>
