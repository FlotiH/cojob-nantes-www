<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{% endblock %}</title>
        <meta name="description" content="{% block description %}{% endblock %}">
        {% if block('canonical') is defined %}
            <link rel="canonical" href="{{ block('canonical') }}">
        {% endif %}

        {% block meta %}{% endblock %}

        {% if app.environment == 'prod' %}
            <!-- Global site tag (gtag.js) - Google Analytics -->
            <script async src="https://www.googletagmanager.com/gtag/js?id=UA-128778519-1"></script>
            <script>
            window.dataLayer = window.dataLayer || [];

            function gtag() {
                dataLayer.push(arguments);
            }

            gtag('js', new Date());
            gtag('config', 'UA-128778519-1');
        </script>

            <!-- Google Tag Manager -->
            <script>(function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({
                    'gtm.start':
                        new Date().getTime(), event: 'gtm.js'
                });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', 'GTM-MDNN4PD');</script>
            <!-- End Google Tag Manager -->
        {% endif %}

        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}">
        <link rel="manifest" href="{{ asset('manifest.json') }}">
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('v2_app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}

        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            navy: {
                                900: '#0E3D67',
                                800: '#123258',
                                700: '#1a4272'
                            },
                            green: {
                                100: '#D6FFF1',
                                300: '#00C27D'
                            },
                            blue: {
                                100: '#F2F8FD',
                                200: '#D3E7F8',
                                300: '#86BDEF',
                                600: '#1A72C1',
                                700: '#145894',
                                900: '#0A2D4C'
                            },
                            orange: {
                                100: '#FFE0BD',
                                200: '#FFCF99'
                            },
                            yellow: {
                                100: '#FEF1D7',
                                300: '#FCCE74',
                                500: '#F9AB10'
                            },
                            brand: {
                                blue: '#1c4f8f',
                                cream: '#fdf1dd',
                                lightblue: '#eaf1fb',
                                teal: '#189b78',
                                amber: '#f6c445',
                                orange: '#f2821f',
                                green: '#00905D',
                                whitedark: '#E9E9E9'
                            }
                        },
                        fontFamily: {
                            sans: ['Poppins', 'ui-sans-serif', 'system-ui', 'sans-serif']
                        }
                    }
                }
            }
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <style>
            body { font-family: 'Inter', sans-serif; }
        </style>
    </head>
    <body class="bg-white text-navy-900" itemscope="" itemtype="https://schema.org/WebPage">
        <meta itemprop="name" content="COJOB Nantes">
        <meta itemprop="description" content="{{ block('description') }}">
        <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
            <meta itemprop="name" content="COJOB Nantes">
            <span itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
                <meta itemprop="url" content="{{ absolute_url(asset('images/logo.png')) }}">
            </span>
        </div>

    {% if app.environment == 'prod' %}
        <!-- Google Tag Manager (noscript) -->
        <noscript>
            <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MDNN4PD"
                    height="0" width="0" style="display:none;visibility:hidden"></iframe>
        </noscript>
        <!-- End Google Tag Manager (noscript) -->
    {% endif %}

    <div itemscope itemtype="https://schema.org/WebSite">
        <link itemprop="url" href="{{ absolute_url(path('homepage')) }}">
        <meta itemprop="inLanguage" content="FR">
        <meta itemprop="image" content="{{ absolute_url(asset('images/promo.jpg')) }}">
        <meta itemprop="headline" content="{{ block('description') }}">
        <div itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
            <meta itemprop="name" content="COJOB Nantes">
            <span itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="url" content="{{ absolute_url(asset('images/logo.png')) }}">
        </span>
        </div>
        <meta itemprop="keywords"
              content="COJOB, COJOB Nantes, association, collectif, recherche, emploi, solidaire, entraide, réseau">
        <meta itemprop="sameAs"
              content="[https://www.facebook.com/cojobnantes/, https://fr.linkedin.com/company/cojob-nantes]">
    </div>

    {% block header %}{% endblock %}

    {% block content %}{% endblock %}

    <footer class="bg-navy-900 pb-8 pt-16 text-center text-white sm:text-left">
        <div class="mx-auto grid max-w-[1048px] border-blue-100 border-b px-6 pb-12 sm:grid-cols-2 lg:grid-cols-[3fr_2fr_2fr_2fr] xl:px-0">
            <div class="mb-8 lg:md-0">
                <a href="{{ path('homepage') }}" class="mx-auto inline-block sm:inline">
                    <picture>
                        <source
                            type="image/avif"
                            srcset="{{ asset('img/v2/logo/footer/logo-white-150.avif') }} 1x,
                            {{ asset('img/v2/logo/footer/logo-white-150@2x.avif') }} 2x"
                        >
                        <source
                            type="image/webp"
                            srcset="{{ asset('img/v2/logo/footer/logo-white-150.webp') }} 1x,
                            {{ asset('img/v2/logo/footer/logo-white-150@2x.webp') }} 2x"
                        >
                        <img
                            src="{{ asset('img/v2/logo/footer/logo-white-150.png') }}"
                            srcset="{{ asset('img/v2/logo/footer/logo-white-150.png') }} 1x,
                            {{ asset('img/v2/logo/footer/logo-white-150@2x.png') }} 2x"
                            alt="Cojob Nantes"
                            class="w-[150px]"
                            width="150"
                            height="52"
                            loading="lazy"
                            decoding="async">
                    </picture>
                </a>
                <p class="m-auto mt-6 max-w-[150px] text-center text-xs sm:ml-0">
                    {{ 'v2.footer.cojob'|trans }}
                </p>
            </div>
            <div class="lg:order-4" itemscope itemtype="https://schema.org/Organization">
                <meta itemprop="name" content="COJOB Nantes">
                <div itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                    <meta itemprop="streetAddress" content="boulevard salvador Allende, Les Salorges 2">
                    <meta itemprop="postalCode" content="44100">
                    <meta itemprop="addressLocality" content="Nantes, France">
                </div>
                <p class="mb-4 text-xs font-semibold">{{ 'v2.footer.social_links'|trans }}</p>
                <link itemprop="url" href="{{ absolute_url(path('homepage')) }}">
                <div class="flex justify-center gap-4 sm:justify-start">
                    <twig:Social:Buttons location='Footer' />
                </div>
            </div>
            <div class="mt-4 sm:mt-0 lg:order-2">
                <ul class="space-y-4 text-xs font-semibold">
                    <li><twig:Menu:Item href="{{ path('homepage') }}#about">{{ 'v2.nav.about'|trans }}</twig:Menu:Item></li>
                    <li><twig:Menu:Item href="{{ path('promos') }}">{{ 'nav.promo'|trans }}</twig:Menu:Item></li>
                    <li><twig:Menu:Item href="{{ path('calendar') }}">{{ 'nav.calendar'|trans }}</twig:Menu:Item></li>
                    <li><twig:Menu:Item href="{{ path('partners') }}">{{ 'v2.nav.partners'|trans }}</twig:Menu:Item></li>
                </ul>
            </div>
            <div class="mt-4 sm:mt-0 lg:order-3">
                <p class="mb-4 text-xs font-semibold">{{ 'nav.support_us'|trans }}</p>
                <ul class="space-y-4 text-xs">
                    <li><twig:Menu:Item href="{{ path('support') }}#join-form" onclick="gtag('event', 'Join Link Footer', {'event_category': 'Button Click'});">
                        {{ 'v2.nav.join'|trans }}
                    </twig:Menu:Item></li>
                    <li><twig:Menu:Item href="{{ path('support') }}#donate-form" onclick="gtag('event', 'Donate Link Footer', {'event_category': 'Button Click'});">
                        {{ 'v2.nav.donate'|trans }}
                    </twig:Menu:Item></li>
                    <li><twig:Menu:Item href="{{ path('support') }}" onclick="gtag('event', 'Become volunteer Link Footer', {'event_category': 'Button Click'});">
                        {{ 'v2.nav.become_volunteer'|trans }}
                    </twig:Menu:Item></li>
                </ul>
            </div>
        </div>
        <div class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-6 px-6 pt-6 text-xs sm:flex-row lg:px-10">
            <p>© COJOB Nantes 2026. Tous droits réservés.</p>
            <twig:Button color="outlined" href="{{ path('legals') }}" class="text-xs">{{ 'footer.legals'|trans }}</twig:Button>
        </div>
    </footer>
    </body>
</html>
