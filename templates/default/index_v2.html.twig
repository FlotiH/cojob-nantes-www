      <div>
        <span class="inline-block bg-brand-amber text-navy-900 text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
          {{ 'v2.home.who_are_we.subtitle1'|trans }}
        </span>
        <p class="text-slate-600 leading-relaxed mb-6">
          {{ 'v2.home.who_are_we.part1'|trans }}
        </p>
        <p class="text-slate-600 leading-relaxed">
          {{ 'v2.home.who_are_we.part2'|trans }}
        </p>
      </div>

      <div class="relative">
        <div class="relative rounded-2xl overflow-hidden h-72 bg-gradient-to-br from-navy-800 to-navy-900 flex items-center justify-center">
          <span class="text-white/70 text-sm">Photo — équipe de bénévoles</span>
        </div>
        <span class="absolute -bottom-3 left-4 bg-brand-blue text-white text-xs font-semibold px-4 py-2 rounded-full shadow-md">
          {{ 'v2.home.who_are_we.subtitle2'|trans }}
        </span>
      </div>
    </div>

    <div class="mt-14">
      <span class="inline-block bg-brand-amber text-navy-900 text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
