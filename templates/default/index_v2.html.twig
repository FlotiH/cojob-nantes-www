{% extends 'base_front_v2.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block description %}{{ 'home.description'|trans }}{% endblock %}

{% block canonical %}{{ absolute_url(path('homepage')) }}{% endblock %}

{% block content %}
<!-- ============ HERO ============ -->
<section class="bg-brand-cream relative overflow-hidden">
  <div class="max-w-[1048px] mx-auto py-16 lg:py-20 grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <span class="inline-block bg-white text-navy-900 text-sm font-semibold px-4 py-2 rounded-full mb-6">
        {{ 'v2.home.next_promo_from'|trans }} {% if promoOpen[0] is defined %} {{ promoOpen[0].start|dateIntervalv2(promoOpen[0].end) }} {% endif %} {# TODO FHA : quoi mettre sinon ? #}
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight text-navy-900">
        {{ 'v2.home.hero.slide1.title'|trans|raw }}
      </h1>
      <p class="mt-6 text-slate-600 text-[15px] leading-relaxed max-w-lg">
         {{ 'v2.home.hero.slide1.subtitle'|trans }}
      </p>

      <div class="mt-6 flex items-center gap-3">
        <div class="flex -space-x-3">
          <span class="w-9 h-9 rounded-full bg-navy-700 border-2 border-brand-cream"></span>
          <span class="w-9 h-9 rounded-full bg-brand-orange border-2 border-brand-cream"></span>
          <span class="w-9 h-9 rounded-full bg-brand-teal border-2 border-brand-cream"></span>
        </div>
        <p class="text-sm font-medium text-navy-900"> {{ 'v2.home.hero.slide1.people_supported'|trans }}</p>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="{{ path('promos') }}#promoAnchor" class="bg-navy-900 text-white font-semibold px-6 py-3.5 rounded-lg hover:bg-navy-800 transition"
           onclick="gtag('event', 'Home Register promo hero', {'event_category': 'Button Click'});">
          {{ 'v2.home.next_promo_registration'|trans }}
        </a>
        <a href="{{ path('promos') }}" class="bg-white text-navy-900 font-semibold px-6 py-3.5 rounded-lg border border-slate-200 hover:bg-slate-50 transition">
          {{ 'v2.home.more'|trans }}
        </a>
      </div>
    </div>

    <div class="relative h-[420px] hidden sm:block">
      <!-- decorative squiggle -->
      <svg class="absolute -left-2 top-6 w-14 h-14 text-brand-blue/60" viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="3"><path d="M2 30c8-12 14 12 22 0s14-12 22 0"/></svg>

      <div class="absolute top-0 right-4 w-64 h-44 rounded-2xl shadow-xl overflow-hidden rotate-2 bg-gradient-to-br from-brand-blue to-navy-700"></div>
      <span class="absolute top-16 left-2 bg-navy-900 text-white text-xs font-semibold px-4 py-2 rounded-full shadow-md -rotate-3">Oser</span>

      <div class="absolute top-28 right-0 w-56 h-40 rounded-2xl shadow-xl overflow-hidden -rotate-2 bg-gradient-to-br from-brand-teal to-emerald-700"></div>
      <span class="absolute top-[13rem] right-8 bg-brand-orange text-white text-xs font-semibold px-4 py-2 rounded-full shadow-md rotate-2">Partager</span>

      <div class="absolute bottom-0 left-8 w-60 h-40 rounded-2xl shadow-xl overflow-hidden rotate-1 bg-gradient-to-br from-amber-400 to-brand-orange"></div>
      <span class="absolute bottom-2 right-16 bg-brand-green text-white text-xs font-semibold px-4 py-2 rounded-full shadow-md -rotate-2">Avancer</span>

      <svg class="absolute bottom-0 right-0 w-16 h-16 text-brand-teal" viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="3"><path d="M8 50 L48 12 M48 12 L34 12 M48 12 L48 26"/></svg>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-10 pb-10 flex items-center justify-between">
    <div class="flex gap-2">
      <span class="w-2 h-2 rounded-full bg-navy-900"></span>
      <span class="w-2 h-2 rounded-full bg-slate-300"></span>
      <span class="w-2 h-2 rounded-full bg-slate-300"></span>
    </div>
    <div class="flex gap-3">
      <button class="w-9 h-9 rounded-full bg-white shadow flex items-center justify-center hover:bg-slate-50">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 6l-6 6 6 6"/></svg>
      </button>
      <button class="w-9 h-9 rounded-full bg-white shadow flex items-center justify-center hover:bg-slate-50">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>
</section>

<!-- ============ QUI SOMMES-NOUS ============ -->
<section id="qui-sommes-nous" class="bg-white py-20">
  <div class="max-w-[1048px] mx-auto">
    <h2 class="text-3xl font-extrabold text-navy-900 mb-10">{{ 'v2.home.who_are_we.title'|trans }}</h2>

    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <span class="inline-block bg-brand-amber text-navy-900 text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
          {{ 'v2.home.who_are_we.subtitle1'|trans }}
        </span>
        <p class="text-slate-600 leading-relaxed mb-6">
          {{ 'v2.home.who_are_we.part1'|trans }}
        </p>
        <p class="text-slate-600 leading-relaxed">
          {{ 'v2.home.who_are_we.part2'|trans }}
        </p>
      </div>

      <div class="relative">
        <div class="relative rounded-2xl overflow-hidden h-72 bg-gradient-to-br from-navy-800 to-navy-900 flex items-center justify-center">
          <span class="text-white/70 text-sm">Photo — équipe de bénévoles</span>
        </div>
        <span class="absolute -bottom-3 left-4 bg-brand-blue text-white text-xs font-semibold px-4 py-2 rounded-full shadow-md">
          {{ 'v2.home.who_are_we.subtitle2'|trans }}
        </span>
      </div>
    </div>

    <div class="mt-14">
      <span class="inline-block bg-brand-amber text-navy-900 text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
        {{ 'v2.home.who_are_we.subtitle3'|trans }}
      </span>
      <p class="text-slate-600 leading-relaxed max-w-3xl">
        {{ 'v2.home.who_are_we.part3'|trans|raw }}
      </p>

      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-brand-cream rounded-2xl p-6 text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-teal flex items-center justify-center">
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.6l-1-1a5.5 5.5 0 10-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 000-7.8z"/></svg>
          </div>
          <p class="font-semibold text-navy-900 text-sm">{{ 'v2.home.who_are_we.item1'|trans }}</p>
        </div>
        <div class="bg-brand-cream rounded-2xl p-6 text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-teal flex items-center justify-center">
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
          </div>
          <p class="font-semibold text-navy-900 text-sm">{{ 'v2.home.who_are_we.item2'|trans }}</p>
        </div>
        <div class="bg-brand-cream rounded-2xl p-6 text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-teal flex items-center justify-center">
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M14 15c2.8 0 5 2 5 5"/></svg>
          </div>
          <p class="font-semibold text-navy-900 text-sm">{{ 'v2.home.who_are_we.item3'|trans }}</p>
        </div>
        <div class="bg-brand-cream rounded-2xl p-6 text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-teal flex items-center justify-center">
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z"/></svg>
          </div>
          <p class="font-semibold text-navy-900 text-sm">{{ 'v2.home.who_are_we.item4'|trans }}</p>
        </div>
      </div>

      <a href="#" class="inline-block mt-8 bg-white text-navy-900 font-semibold px-6 py-3 rounded-lg border border-slate-200 hover:bg-slate-50 transition">
        {{ 'v2.home.more'|trans }}
      </a>
    </div>
  </div>
</section>

<!-- ============ LA PROMO ============ -->
<section id="promo" class="bg-brand-lightblue py-20">
  <div class="max-w-[1048px] mx-auto">
    <h2 class="text-3xl font-extrabold text-navy-900 mb-12 max-w-2xl">
      {{ 'v2.home.promo.title'|trans }}
    </h2>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white rounded-2xl p-7">
        <span class="inline-block bg-brand-amber text-navy-900 text-sm font-semibold px-4 py-1.5 rounded-full mb-5">
          {{ 'v2.home.promo.bloc1.title'|trans }}
        </span>
        <p class="text-slate-600 text-sm leading-relaxed mb-4">
           {{ 'v2.home.promo.bloc1.text1'|trans }}
        </p>
        <p class="text-slate-600 text-sm leading-relaxed">
          {{ 'v2.home.promo.bloc1.text2'|trans }}
        </p>
        <p class="flex items-center gap-2 text-navy-900 text-sm font-medium mt-6">
          <svg class="w-4 h-4 text-brand-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-7.4 7-12.5A7 7 0 105 9.5C5 14.6 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          {{ 'v2.home.promo.bloc1.location'|trans }}
        </p>
      </div>

      <div class="bg-white rounded-2xl p-7">
        <span class="inline-block bg-brand-amber text-navy-900 text-sm font-semibold px-4 py-1.5 rounded-full mb-5">
          {{ 'v2.home.promo.bloc2.title'|trans }}
        </span>
        <p class="text-slate-600 text-sm leading-relaxed mb-4">
          {{ 'v2.home.promo.bloc2.text1'|trans }}
        </p>
        <p class="text-slate-600 text-sm leading-relaxed">
          {{ 'v2.home.promo.bloc2.text2'|trans }}
        </p>
      </div>

      <div class="bg-white rounded-2xl p-7">
        <span class="inline-block bg-brand-amber text-navy-900 text-sm font-semibold px-4 py-1.5 rounded-full mb-5">
          {{ 'v2.home.promo.bloc3.title'|trans }}
        </span>
        <p class="text-slate-600 text-sm leading-relaxed">
          {{ 'v2.home.promo.bloc3.text1'|trans }}
        </p>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-4">
      <a href="{{ path('promos') }}#promoAnchor" class="bg-navy-900 text-white font-semibold px-6 py-3.5 rounded-lg hover:bg-navy-800 transition"
        onclick="gtag('event', 'Home Register promo bloc promo', {'event_category': 'Button Click'});">
        {{ 'v2.home.next_promo_registration'|trans }}
      </a>
      <a href="{{ path('promos') }}" class="bg-white text-navy-900 font-semibold px-6 py-3.5 rounded-lg border border-slate-200 hover:bg-slate-50 transition">
        {{ 'v2.home.more'|trans }}
      </a>
    </div>
  </div>
</section>

<!-- ============ ACTUALITÉS ============ -->
<section id="actualites" class="py-20">
  <div class="max-w-[1048px] mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-[26px] font-bold font-[Poppins]">{{ 'v2.home.articles'|trans }}</h2>
      <a href="{{ path('calendar') }}" class="hidden sm:inline-flex text-[15px] font-semibold px-5 py-2.5 rounded-md border border-brand-whitedark hover:bg-slate-50 transition">
        {{ 'v2.home.see_agenda'|trans }}
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-4">
      {% for article in articles %}
        <article class="rounded-sm bg-blue-100 border border-brand-whitedark p-4">
          <div class="h-[180px] bg-[url({{ article.imageLink }})] bg-center bg-no-repeat bg-cover rounded-sm"></div>
          <div class="pt-4 text-[13px]">
            <div class="inline-flex items-center gap-1 {{ article.tag.color() }} text-white text-[14px] font-semibold font-[Poppins] px-2.5 py-0.5 rounded-md mb-4">{{ article.tag.svg()|raw }} <span>{{ article.tag|trans }}</span></div>
            <h3 class="font-semibold text-[15px] mb-4">{{ article.title }}</h3>
            {% if article.start %}
              {% if article.end %}
                <p class="flex items-center gap-2 mb-2">
                  <svg width="12" height="14" viewBox="0 0 12 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.48333 10.1833C6.16111 9.86111 6 9.46667 6 9C6 8.53333 6.16111 8.13889 6.48333 7.81667C6.80556 7.49444 7.2 7.33333 7.66667 7.33333C8.13333 7.33333 8.52778 7.49444 8.85 7.81667C9.17222 8.13889 9.33333 8.53333 9.33333 9C9.33333 9.46667 9.17222 9.86111 8.85 10.1833C8.52778 10.5056 8.13333 10.6667 7.66667 10.6667C7.2 10.6667 6.80556 10.5056 6.48333 10.1833ZM1.33333 13.3333C0.966667 13.3333 0.652889 13.2029 0.392 12.942C0.131111 12.6811 0.000444444 12.3671 0 12V2.66667C0 2.3 0.130667 1.98622 0.392 1.72533C0.653333 1.46444 0.967111 1.33378 1.33333 1.33333H2V0H3.33333V1.33333H8.66667V0H10V1.33333H10.6667C11.0333 1.33333 11.3473 1.464 11.6087 1.72533C11.87 1.98667 12.0004 2.30044 12 2.66667V12C12 12.3667 11.8696 12.6807 11.6087 12.942C11.3478 13.2033 11.0338 13.3338 10.6667 13.3333H1.33333ZM1.33333 12H10.6667V5.33333H1.33333V12ZM1.33333 4H10.6667V2.66667H1.33333V4Z" fill="#0E3D67"/></svg>
                  {{ article.start|dateIntervalv2(article.end) }}
                </p>
              {% else %}
                 <p class="flex items-center gap-2 mb-2">
                  <svg width="12" height="14" viewBox="0 0 12 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.48333 10.1833C6.16111 9.86111 6 9.46667 6 9C6 8.53333 6.16111 8.13889 6.48333 7.81667C6.80556 7.49444 7.2 7.33333 7.66667 7.33333C8.13333 7.33333 8.52778 7.49444 8.85 7.81667C9.17222 8.13889 9.33333 8.53333 9.33333 9C9.33333 9.46667 9.17222 9.86111 8.85 10.1833C8.52778 10.5056 8.13333 10.6667 7.66667 10.6667C7.2 10.6667 6.80556 10.5056 6.48333 10.1833ZM1.33333 13.3333C0.966667 13.3333 0.652889 13.2029 0.392 12.942C0.131111 12.6811 0.000444444 12.3671 0 12V2.66667C0 2.3 0.130667 1.98622 0.392 1.72533C0.653333 1.46444 0.967111 1.33378 1.33333 1.33333H2V0H3.33333V1.33333H8.66667V0H10V1.33333H10.6667C11.0333 1.33333 11.3473 1.464 11.6087 1.72533C11.87 1.98667 12.0004 2.30044 12 2.66667V12C12 12.3667 11.8696 12.6807 11.6087 12.942C11.3478 13.2033 11.0338 13.3338 10.6667 13.3333H1.33333ZM1.33333 12H10.6667V5.33333H1.33333V12ZM1.33333 4H10.6667V2.66667H1.33333V4Z" fill="#0E3D67"/></svg>
                  {{ article.start|format_datetime(locale: 'fr', pattern: 'dd MMMM YYYY') }}
                </p>
              {% endif %}
            {% endif %}
            {% if article.startTime %}
              <p class="flex items-center gap-2 mb-2">
