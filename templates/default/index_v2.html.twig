        </button>
      </div>
    </div>
  </div>
</section>

<!-- ============ PARTENAIRES ============ -->
<section class="bg-white py-16">
  <div class="max-w-[1048px] mx-auto">
    <h2 class="text-[26px] font-bold font-[Poppins] text-navy-900 mb-10">{{ 'v2.home.partners'|trans }}</h2>
    <div class="flex flex-wrap items-center">
    {% for partner in partners %}
      {% if partner.link %}
        <a class="w-1/6 max-w-[170px]" href="{{ partner.link }}" target="_blank" rel="noopener noreferrer">
          <img src="{{ vich_uploader_asset(partner, 'imageFile') }}" alt="{{ partner.name }}"/> {# TODO FHA : gérer les bons formats d'image #}
        </a>
      {% else %}
        <img class="w-1/6 max-w-[170px]" src="{{ vich_uploader_asset(partner, 'imageFile') }}" alt="{{ partner.name }}"/>
      {% endif %}
    {% endfor %}
    </div>
  </div>
</section>

<!-- ============ ILS PARLENT DE NOUS ============ -->
<section class="bg-brand-lightblue py-20">
  <div class="max-w-[1048px] mx-auto">
    <h2 class="text-[26px] font-bold font-[Poppins] text-navy-900 mb-6">{{ 'v2.home.talk_about_us'|trans }}</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-4">

      {% for talk in talks %}
        <a href="{{ talk.link }}" class="flex items-start gap-3 bg-white rounded-xl p-2 hover:shadow-md transition"
          target="_blank" rel="noopener noreferrer">
          <img class="w-8 h-8 shrink-0 border border-brand-whitedark" src="{{ vich_uploader_asset(talk, 'imageFile') }}" alt="{{ talk.source }}"/> {# TODO FHA : gestion des formats #}
          <div>
            <p class="text-[13px] font-semibold text-navy-900 leading-snug">{{ talk.title }}</p>
            <p class="text-[11px] text-navy-900">{{ talk.source }} · {{ talk.date|format_datetime(locale: 'fr', pattern: 'dd MMMM YYYY') }}</p>
          </div>

          <div class="bg-brand-whitedark rounded-md p-1.5">
