            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.6l-1-1a5.5 5.5 0 10-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 000-7.8z"/></svg>
          </div>
          <p class="font-semibold text-navy-900 text-sm">{{ 'v2.home.who_are_we.item1'|trans }}</p>
        </div>
        <div class="bg-brand-cream rounded-2xl p-6 text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-teal flex items-center justify-center">
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
          </div>
          <p class="font-semibold text-navy-900 text-sm">{{ 'v2.home.who_are_we.item2'|trans }}</p>
        </div>
        <div class="bg-brand-cream rounded-2xl p-6 text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-teal flex items-center justify-center">
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M14 15c2.8 0 5 2 5 5"/></svg>
          </div>
          <p class="font-semibold text-navy-900 text-sm">{{ 'v2.home.who_are_we.item3'|trans }}</p>
        </div>
        <div class="bg-brand-cream rounded-2xl p-6 text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-brand-teal flex items-center justify-center">
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z"/></svg>
          </div>
          <p class="font-semibold text-navy-900 text-sm">{{ 'v2.home.who_are_we.item4'|trans }}</p>
        </div>
      </div>

      <a href="#" class="inline-block mt-8 bg-white text-navy-900 font-semibold px-6 py-3 rounded-lg border border-slate-200 hover:bg-slate-50 transition">
        {{ 'v2.home.more'|trans }}
      </a>
    </div>
  </div>
</section>

<!-- ============ LA PROMO ============ -->
<section id="promo" class="bg-brand-lightblue py-20">
  <div class="max-w-[1048px] mx-auto">
    <h2 class="text-3xl font-extrabold text-navy-900 mb-12 max-w-2xl">
      {{ 'v2.home.promo.title'|trans }}
    </h2>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white rounded-2xl p-7">
        <span class="inline-block bg-brand-amber text-navy-900 text-sm font-semibold px-4 py-1.5 rounded-full mb-5">
          {{ 'v2.home.promo.bloc1.title'|trans }}
        </span>
        <p class="text-slate-600 text-sm leading-relaxed mb-4">
           {{ 'v2.home.promo.bloc1.text1'|trans }}
        </p>
        <p class="text-slate-600 text-sm leading-relaxed">
          {{ 'v2.home.promo.bloc1.text2'|trans }}
        </p>
        <p class="flex items-center gap-2 text-navy-900 text-sm font-medium mt-6">
          <svg class="w-4 h-4 text-brand-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-7.4 7-12.5A7 7 0 105 9.5C5 14.6 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          {{ 'v2.home.promo.bloc1.location'|trans }}
        </p>
      </div>

      <div class="bg-white rounded-2xl p-7">
        <span class="inline-block bg-brand-amber text-navy-900 text-sm font-semibold px-4 py-1.5 rounded-full mb-5">
          {{ 'v2.home.promo.bloc2.title'|trans }}
        </span>
        <p class="text-slate-600 text-sm leading-relaxed mb-4">
          {{ 'v2.home.promo.bloc2.text1'|trans }}
        </p>
        <p class="text-slate-600 text-sm leading-relaxed">
          {{ 'v2.home.promo.bloc2.text2'|trans }}
        </p>
      </div>

      <div class="bg-white rounded-2xl p-7">
        <span class="inline-block bg-brand-amber text-navy-900 text-sm font-semibold px-4 py-1.5 rounded-full mb-5">
          {{ 'v2.home.promo.bloc3.title'|trans }}
        </span>
        <p class="text-slate-600 text-sm leading-relaxed">
          {{ 'v2.home.promo.bloc3.text1'|trans }}
        </p>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-4">
      <a href="{{ path('promos') }}#promoAnchor" class="bg-navy-900 text-white font-semibold px-6 py-3.5 rounded-lg hover:bg-navy-800 transition"
        onclick="gtag('event', 'Home Register promo bloc promo', {'event_category': 'Button Click'});">
        {{ 'v2.home.next_promo_registration'|trans }}
      </a>
      <a href="{{ path('promos') }}" class="bg-white text-navy-900 font-semibold px-6 py-3.5 rounded-lg border border-slate-200 hover:bg-slate-50 transition">
        {{ 'v2.home.more'|trans }}
      </a>
    </div>
  </div>
</section>

<!-- ============ ACTUALITÉS ============ -->
<section id="actualites" class="bg-white py-20">
  <div class="max-w-[1048px] mx-auto">
    <div class="flex items-center justify-between mb-10">
      <h2 class="text-3xl font-extrabold text-navy-900">{{ 'v2.home.articles'|trans }}</h2>
      <a href="{{ path('calendar') }}" class="hidden sm:inline-flex bg-white text-navy-900 font-semibold px-5 py-2.5 rounded-lg border border-slate-200 hover:bg-slate-50 transition">
        {{ 'v2.home.see_agenda'|trans }}
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {% for article in articles %}
        <article class="rounded-2xl overflow-hidden border border-slate-100 shadow-sm">
          <div class="h-40 bg-gradient-to-br from-amber-200 to-brand-orange"
            style="background-image: url({{ article.imageLink }});background-repeat: no-repeat;background-position: center;background-size: cover;"></div>
          <div class="p-6">
            {# TODO à faire <span class="inline-flex items-center gap-1.5 {{ article.tag.color() }} text-white text-xs font-semibold px-3 py-1 rounded-full mb-4">{{ article.tag }}</span> #}
            <h3 class="font-semibold text-navy-900 mb-2">{{ article.title }}</h3>
            {% if article.start %}
              {% if article.end %}
                <p class="flex items-center gap-2 text-slate-500 text-xs mb-1">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
                  {{ article.start|dateIntervalv2(article.end) }}
                </p>
              {% else %}
                {{ article.start|format_datetime(locale: 'fr', pattern: 'dd MMMM YYYY') }}
              {% endif %}
            {% endif %}
            {% if article.startTime %}
              <p class="flex items-center gap-2 text-slate-500 text-xs mb-4">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="9"/></svg>
                {{ 'v2.home.article_from'|trans }} {{ article.startTime }}
              </p>
            {% endif %}
            {% if article.location %}
              <p class="flex items-center gap-2 text-slate-500 text-xs mb-4">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-7.4 7-12.5A7 7 0 105 9.5C5 14.6 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                {{ article.location }}
              </p>
            {% endif %}
            <a href="{{ article.buttonLink }}" class="text-brand-blue text-sm font-semibold hover:underline">{{ article.buttonLabel }}</a>
          </div>
        </article>
      {% endfor %}
    </div>

    {# TODO FHA : faire le carousel #}
    <div class="mt-8 flex items-center justify-between">
      <span class="w-2 h-2 rounded-full bg-navy-900"></span>
      <div class="flex gap-3">
        <button class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center hover:bg-slate-50">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button class="w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center hover:bg-slate-50">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- ============ TÉMOIGNAGES / CHIFFRES ============ -->
<section class="bg-brand-cream py-20">
  <div class="max-w-[1048px] mx-auto">
    <h2 class="text-3xl font-extrabold text-navy-900 mb-12">
      {{ 'v2.home.testimonies'|trans }}
    </h2>

    <div class="grid sm:grid-cols-3 gap-8 mb-14 text-center">
      <div>
        <p class="text-5xl font-extrabold text-brand-teal">{{ 'v2.home.stats.more_efficient.percent'|trans }}</p>
        <p class="text-slate-600 text-sm mt-2">{{ 'v2.home.stats.more_efficient.label'|trans }}</p>
      </div>
      <div>
        <p class="text-5xl font-extrabold text-brand-teal">{{ 'v2.home.stats.gained_confidence.percent'|trans }}</p>
        <p class="text-slate-600 text-sm mt-2">{{ 'v2.home.stats.gained_confidence.label'|trans }}</p>
      </div>
      <div>
        <p class="text-5xl font-extrabold text-brand-teal">{{ 'v2.home.stats.pro_networking.percent'|trans }}</p>
        <p class="text-slate-600 text-sm mt-2">{{ 'v2.home.stats.pro_networking.label'|trans }}</p>
      </div>
    </div>

    {# TODO FHA : faire le carousel #}
    <div class="grid md:grid-cols-3 gap-6">
      {% for testimony in testimonies %}
        <article class="bg-white rounded-2xl p-7">
          <h3 class="font-semibold text-navy-900 mb-3">{{ testimony.subtitle }}</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-6">
            {{ testimony.content|raw }}
          </p>
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full {% if loop.index0 == 0 %}bg-navy-700{% elseif loop.index0 == 1 %}bg-brand-orange{% else %}bg-brand-teal{% endif %} flex items-center justify-center text-white text-xs font-semibold">J</span>
            <div>
              <p class="text-sm font-semibold text-navy-900">{{ testimony.firstname }}</p>
              <p class="text-xs text-slate-500">{{ testimony.age }} ans · {{ testimony.promo }}</p>
            </div>
