          <div class="text-navy-900 text-[15px]/[22px] mb-6">
            {{ testimony.content|raw }}
          </div>
          <div class="flex items-center gap-3 mt-auto">
            <span class="w-11 h-11 rounded-full {% if loop.index0 % 3 == 0 %}bg-blue-100{% elseif loop.index0 % 3 == 1 %}bg-orange-200{% else %}bg-green-300{% endif %} flex items-center justify-center text-[15px] font-semibold">{{ testimony.firstname|first }}</span>
