{% props loop, imgName, imgAlt %}

<div class="flex flex-[0_0_100%] min-w-0 flex-col items-center gap-8 md:flex-row">
    <div class="md:flex-1 md:order-2">
        <picture>
            <source
                media="(max-width: 768px)"
                type="image/avif"
                srcset="{{ asset('img/v2/header/xs/' ~ imgName ~ '-380.avif') }} 1x, {{ asset('img/v2/header/xs/' ~ imgName ~ '-380@2x.avif') }} 2x"
                width="380" height="300">
            <source
                media="(max-width: 768px)"
                type="image/webp"
                srcset="{{ asset('img/v2/header/xs/' ~ imgName ~ '-380.webp') }} 1x, {{ asset('img/v2/header/xs/' ~ imgName ~ '-380@2x.webp') }} 2x"
                width="380" height="300">
            <source
                media="(max-width: 768px)"
                srcset="{{ asset('img/v2/header/xs/' ~ imgName ~ '-380.png') }} 1x, {{ asset('img/v2/header/xs/' ~ imgName ~ '-380@2x.png') }} 2x"
                width="380" height="300">

            <source
                type="image/avif"
                srcset="{{ asset('img/v2/header/' ~ imgName ~ '-508.avif') }} 1x, {{ asset('img/v2/header/' ~ imgName ~ '-508@2x.avif') }} 2x"
                width="508" height="521">
            <source
                type="image/webp"
                srcset="{{ asset('img/v2/header/' ~ imgName ~ '-508.webp') }} 1x, {{ asset('img/v2/header/' ~ imgName ~ '-508@2x.webp') }} 2x"
                width="508" height="521">

            <img
                src="{{ asset('img/v2/header/' ~ imgName ~ '-508.png') }}"
                srcset="{{ asset('img/v2/header/' ~ imgName ~ '-508.png') }} 1x, {{ asset('img/v2/header/' ~ imgName ~ '-508@2x.png') }} 2x"
                width="508" height="521"
                alt="{{ imgAlt }}"
                class="h-[300px] w-auto sm:h-80 md:h-auto md:w-full"
                {% if loop == 0 %}
                    fetchpriority="high"
                {% else %}
                    loading="lazy"
                    decoding="async"
                {% endif %}>
        </picture>
    </div>
    <div class="md:flex-1 md:order-1">
        {% block content '' %}
    </div>
</div>
