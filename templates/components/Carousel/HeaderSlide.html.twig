{% props loop, imgName, imgAlt %}

<div class="flex flex-[0_0_100%] min-w-0 flex-col items-center gap-8 md:flex-row">
    <div class="md:flex-1 md:order-2">
        <picture>
            <source
                type="image/avif"
                srcset="{{ asset('img/v2/header/xs/' ~ imgName ~ '-380.avif') }} 380w,
                {{ asset('img/v2/header/' ~ imgName ~ '-508.avif') }} 508w,
                {{ asset('img/v2/header/xs/' ~ imgName ~ '-380@2x.avif') }} 760w,
                {{ asset('img/v2/header/' ~ imgName ~ '-508@2x.avif') }} 1016w"
                sizes="(max-width: 768px) 380px, 508px"
            >
            <source
                type="image/webp"
                srcset="{{ asset('img/v2/header/xs/' ~ imgName ~ '-380.webp') }} 380w,
                {{ asset('img/v2/header/' ~ imgName ~ '-508.webp') }} 508w,
                {{ asset('img/v2/header/xs/' ~ imgName ~ '-380@2x.webp') }} 760w,
                {{ asset('img/v2/header/' ~ imgName ~ '-508@2x.webp') }} 1016w"
                sizes="(max-width: 768px) 380px, 508px"
            >
            <img
                src="{{ asset(imgName ~ '-508.png') }}"
                srcset="{{ asset('img/v2/header/xs/' ~ imgName ~ '-380.png') }} 380w,
                {{ asset('img/v2/header/' ~ imgName ~ '-508.png') }} 508w,
                {{ asset('img/v2/header/xs/' ~ imgName ~ '-380@2x.png') }} 760w,
                {{ asset('img/v2/header/' ~ imgName ~ '-508@2x.png') }} 1016w"
                sizes="(max-width: 768px) 380px, 508px"
                width="508"
                height="521"
                class="h-[300px] w-auto sm:h-80 md:h-auto md:w-full"
                alt="{{ imgAlt }}"
            {% if loop == 0 %}
                fetchpriority="high"
            {% else %}
                loading="lazy"
                decoding="async"
            {% endif %}
            >
        </picture>
    </div>
    <div class="md:flex-1 md:order-1">
        {% block content '' %}
    </div>
</div>
