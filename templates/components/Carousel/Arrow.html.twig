{% props carouselName, direction = 'prev' %}

<button {{ stimulus_action(carouselName, direction) }}
    class="flex h-10 w-14 items-center justify-center rounded-s border border-brand-whitedark bg-white">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        {% if direction == 'prev' %}
            <path d="M15 6l-6 6 6 6"/>
        {% elseif direction == 'next' %}
            <path d="M9 6l6 6-6 6"/>
        {% endif %}
    </svg>
</button>
