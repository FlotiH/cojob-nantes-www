{% props carouselName, direction = 'prev' %}

<button {{ stimulus_action(carouselName, direction) }}
    class="w-14 h-10 rounded-s bg-white border border-brand-whitedark flex items-center justify-center">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        {% if direction == 'prev' %}
            <path d="M15 6l-6 6 6 6"/>
        {% elseif direction == 'next' %}
            <path d="M9 6l6 6-6 6"/>
        {% endif %}
    </svg>
</button>
