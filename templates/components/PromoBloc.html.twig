{% props title, text1, text2 %}

<div class="bg-white rounded-md px-2 py-4 lg:px-4 text-center border border-brand-whitedark">
    <twig:Tag type="title" color="yellow300" class="mb-4">
        {{ title }}
    </twig:Tag>
     <p class="text-[15px] text-left mb-4">
        {{ text1 }}
    </p>
    <p class="text-[15px] text-left">
        {{ text2 }}
    </p>
    {% block content '' %}
</div>
