{% props counterValue, counterName %}

<div>
    <p data-controller="counter"
        data-counter-target-value="{{ counterValue }}"
        class="text-[38px]/[48px] font-[Poppins] font-extrabold text-navy-900 counter {{ counterName }}"></p>
    <p class="text-[15px]">{% block content '' %}</p>
</div>
