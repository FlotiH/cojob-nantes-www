{
    "type": "project",
    "license": "proprietary",
    "name": "flotih/cojob-nantes-www",
    "description": "Website for Cojob Nantes association",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "beberlei/doctrineextensions": "^1.5",
        "doctrine/doctrine-bundle": "^3.3.1",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.8",
        "easycorp/easyadmin-bundle": "^5.5.0",
        "egulias/email-validator": "^4.0.4",
        "eluceo/ical": "^2.17",
        "friendsofsymfony/ckeditor-bundle": "^2.8",
        "gedmo/doctrine-extensions": "^3.22.1",
        "google/apiclient": "^2.19.4",
        "imagine/imagine": "^1.5.4",
        "incenteev/composer-parameter-handler": "^2.3",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.3",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "symfony/apache-pack": "^1.0.1",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^3.0|^4.0.2",
        "symfony/notifier": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/requirements-checker": "^2.0.3",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/yaml": "8.1.*",
        "tattali/calendar-bundle": "^8.2.1",
        "twig/cssinliner-extra": "^3.26",
        "twig/extra-bundle": "^3.24",
        "twig/inky-extra": "^3.26",
        "twig/string-extra": "^3.24",
        "twig/twig": "^3.28.0",
        "vich/uploader-bundle": "^2.9.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "ckeditor:install": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "requirements-checker": "script"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "app:load-fixtures": [
            "bin/console do:da:dr --force --if-exists --env=test",
            "bin/console do:da:cr --env=test",
            "bin/console do:mi:mi -n --allow-no-migration --env=test",
            "bin/console do:fi:lo -n --env=test"
        ],
        "app:tests": [
            "bin/console ca:wa --env=test",
            "@app:load-fixtures",
            "SYMFONY_DEPRECATIONS_HELPER=disabled vendor/bin/phpunit"
        ],
        "app:tests-with-code-coverage": [
            "bin/console ca:wa --env=test",
            "@app:load-fixtures",
            "XDEBUG_MODE=coverage SYMFONY_DEPRECATIONS_HELPER=disabled vendor/bin/phpunit --coverage-html public/test-coverage"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.18",
        "phpstan/phpstan": "^2.2.8",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^13.2.6",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/phpunit-bridge": "^7.4.14",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "uxcode-fr/image-optimizer": "^1.0.6",
        "vincentlanglet/twig-cs-fixer": "^4.0.2"
    }
}
